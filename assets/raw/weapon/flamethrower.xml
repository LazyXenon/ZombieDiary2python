	<animation name="walk_upper" duration="0.5">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/ft_upper_sheets.xml"
			   animatioin_xml="config/soldier/01/ft_walk_animations.xml" zorder="3" />
	</animation>
	
	<animation name="stand_upper" duration="0.5">
