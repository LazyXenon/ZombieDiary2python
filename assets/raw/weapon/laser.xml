<?xml version="1.0" encoding="UTF-8"?>
<soldier weapon_name="laser"  min_interval="0.2" multi_shot="1" dir_refire="1"
         width="300" height="300" centerX="118" soldier_width="150">

	<animation name="walk_upper" duration="0.6">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/laser_upper_sheets.xml"
			   animatioin_xml="config/soldier/01/laser_walk_animations.xml" zorder="3" />
	</animation>
	
	<animation name="stand_upper" duration="0.6">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/laser_upper_sheets.xml"
			   animatioin_xml="config/soldier/01/laser_stand_animations.xml" zorder="3" />
	</animation>
	
	<animation name="fire_upper" duration="0.15">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/laser_upper_sheets.xml"
			   animatioin_xml="config/soldier/01/laser_fire_animations.xml" zorder="3" />
	</animation>
	
	<animation name="walk_lower" duration="0.6">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/lower_sheets.xml"
			   animatioin_xml="config/soldier/01/laser_walk_animations.xml" zorder="2" />
	</animation>
	
	<animation name="stand_lower" duration="0.6">
		<Flash offset_x="0" offset_y="0" sheet_xml="config/soldier/01/lower_sheets.xml"
			   animatioin_xml="config/soldier/01/laser_stand_animations.xml" zorder="2" />
	</animation>
	
	<weapon_effect type="firearm" damage="600" shoot_distance="900" area_damage="1" 
	               bomb_radius="0" shotback_dis="20">
		<laser_light offset_x="230" offset_y="230"
		             laser_point_0="pic/gun/laser/laser_point_0.png" 
					 laser_point_1="pic/gun/laser/laser_point_1.png"
					 laser_line_0="pic/gun/laser/laser_line_0.png"
					 laser_line_1="pic/gun/laser/laser_line_1.png"/>
	</weapon_effect>
	
	<Shadow offset_y="297" tex="pic/soldier/yinying.png" />
</soldier>
